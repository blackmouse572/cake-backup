{
  "name": "@cage/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/client.ts"
  },
  "scripts": {
    "dev": "node init && wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "db:migrate:staging": "wrangler d1 migrations apply cage-staging --env staging --remote",
    "deploy:demo": "wrangler deploy --env demo",
    "db:migrate:demo": "wrangler d1 migrations apply cage-demo --env demo --remote",
    "typegen": "wrangler types",
    "typecheck": "tsc",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply cage --local"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.16",
    "@cage/db": "workspace:*",
    "@cage/i18n": "workspace:*",
    "@cage/shared": "workspace:*",
    "@hono/zod-validator": "^0.9.1",
    "better-auth": "1.7.16",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
