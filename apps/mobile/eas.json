{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-staging.cage.vn"
      }
    },
    "development-disguise": {
      "extends": "development",
      "env": {
        "APP_VARIANT": "disguise",
        "EXPO_PUBLIC_DISGUISE": "on",
        "EXPO_PUBLIC_API_URL": "https://api-staging.cage.vn"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    }
  }
}
